# Servidor
PORT=4000
CORS_ORIGIN=http://localhost:5173

# MySQL
DB_HOST=localhost
DB_PORT=3307
DB_USER=artificialcode
DB_PASSWORD=artificialcode
DB_NAME=artificialcode

# Autenticação
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_IN=12h
# Expiração do token quando o usuário marca "manter conectado"
JWT_REMEMBER_EXPIRES_IN=30d

# Kanban (produção automatizada) — quantos cards o worker local pode rodar
# "doing" ao mesmo tempo (uma sessão tmux/claude por card)
KANBAN_MAX_CONCURRENT_CARDS=3

# Atendimento comercial com IA no chat do site
#
# Exige o CLI `claude` instalado e autenticado no MESMO usuário que roda este backend.
# Sem ele o worker falha e o visitante recebe o fallback de WhatsApp.
#
# O prefixo AI_CHAT_ é de propósito: o ambiente pode já ter CLAUDE_MODEL/CLAUDE_EFFORT
# definidos (o próprio Claude Code exporta), e o dotenv não sobrescreve variável existente.
AI_CHAT_ENABLED=true
AI_CHAT_MODEL=claude-opus-5
AI_CHAT_EFFORT=high
AI_CHAT_FALLBACK_MODEL=claude-sonnet-5
AI_CHAT_MAX_CONCURRENT=1
AI_CHAT_MAX_QUEUE_DEPTH=8
AI_CHAT_TIMEOUT_MS=180000
AI_CHAT_POLL_MS=2000
# Teto de mensagens do visitante por conversa antes de a IA parar de responder
AI_CHAT_MAX_TURNS_PER_CONVERSATION=40
# Etiqueta usada nos cards criados a partir de orçamento confirmado
# (só letras, números, ponto, hífen e underline — validação do kanban)
AI_CHAT_LABEL=cliente

# Usado apenas por `npm run seed` para criar o primeiro admin
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=troque-esta-senha

# E-mail (usado em "esqueci minha senha")
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=parceiros@artificialstudio.com
FRONTEND_URL=http://localhost:5173
